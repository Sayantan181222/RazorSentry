# RazorSentry — Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to git

# PostgreSQL connection string
# When using docker compose, this is set automatically
# For local development without Docker, use SQLite:
# DATABASE_URL=sqlite:///razorsentry.db
DATABASE_URL=postgresql://razorsentry:razorsentry_pass@db:5432/razorsentry

# Redis connection string
# When using docker compose, this is set automatically
REDIS_URL=redis://redis:6379

# Groq API key for analyst notes (optional — service works without it)
# Get your key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# PII blinding salt — any random 32+ character string
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
PII_SALT=change-this-to-a-random-secret-in-production

# Model file paths (defaults work with docker compose)
MODEL_PATH=models/lgbm_model.pkl
THRESHOLD_PATH=models/threshold.txt
REFERENCE_STATS_PATH=models/reference_stats.json

# Set to true only when running load tests to bypass rate limiting
LOAD_TEST_MODE=false
