{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE"
  },
  "deploy": {
    "startCommand": "uvicorn src.service:app --host 0.0.0.0 --port $PORT --workers 2 --timeout-keep-alive 30 --timeout-graceful-shutdown 10",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
